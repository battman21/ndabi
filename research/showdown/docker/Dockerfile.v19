FROM rust:1.99-trixie AS builder

# Debian 13 trixie. Upgrade the image, then require the rustc and CA floors.
RUN apt-get update \
    && apt-get upgrade --yes \
    && apt-get install --yes --no-install-recommends ca-certificates \
    && dpkg --compare-versions "$(rustc --version | awk '{print $2}')" ge "1.96.1" \
    && dpkg --compare-versions "$(dpkg-query -W -f '$${Version}' ca-certificates)" ge "20250419+deb13u1" \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY research/showdown/docker/build-v19/Cargo.toml research/showdown/docker/build-v19/Cargo.lock /workspace/campaign/
COPY research/showdown/src /workspace/campaign/src

RUN RUSTFLAGS="-D warnings" cargo build \
    --release \
    --locked \
    --manifest-path /workspace/campaign/Cargo.toml \
    --bin ndabi_v19

FROM debian:trixie-slim AS runtime

RUN apt-get update \
    && apt-get upgrade --yes \
    && apt-get install --yes --no-install-recommends ca-certificates curl time \
    && dpkg --compare-versions "$(dpkg-query -W -f '$${Version}' ca-certificates)" ge "20250419+deb13u1" \
    && curl --fail --silent --show-error https://example.com --output /dev/null \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /workspace/campaign/target/release/ndabi_v19 /usr/local/bin/ndabi_v19

LABEL org.opencontainers.image.title="NDABI showdown v1.9 literal lossless"
LABEL org.whitetree.ndabi.campaign="v1.9"
LABEL org.whitetree.ndabi.rust="1.99"

USER 65532:65532
ENTRYPOINT ["/usr/local/bin/ndabi_v19"]
