FROM rust:1.99-trixie AS builder

# Debian 13 trixie. Upgrade the image, then require the rustc and CA floors.
RUN apt-get update \
    && apt-get upgrade --yes \
    && apt-get install --yes --no-install-recommends ca-certificates \
    && dpkg --compare-versions "$(rustc --version | awk '{print $2}')" ge "1.96.1" \
    && dpkg --compare-versions "$(dpkg-query -W -f '$${Version}' ca-certificates)" ge "20250419+deb13u1" \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/campaign/research/showdown/docker/build-v42
COPY research/showdown/docker/build-v42/Cargo.toml research/showdown/docker/build-v42/Cargo.lock ./
COPY research/showdown/docker/lib-v42.rs ../lib-v42.rs
COPY research/showdown/src/alloc.rs ../../src/alloc.rs
COPY research/showdown/src/bin/ndabi_v42.rs ../../src/bin/ndabi_v42.rs
COPY research/showdown/src/v42/mod.rs ../../src/v42/mod.rs
COPY crates/ndabi-postgres ../../../../crates/ndabi-postgres
COPY crates/ndabi-session ../../../../crates/ndabi-session

RUN RUSTFLAGS="-D warnings" cargo build --release --locked --bin ndabi_v42

FROM debian:trixie-slim AS runtime

RUN apt-get update \
    && apt-get upgrade --yes \
    && apt-get install --yes --no-install-recommends ca-certificates curl \
    && dpkg --compare-versions "$(dpkg-query -W -f '$${Version}' ca-certificates)" ge "20250419+deb13u1" \
    && curl --fail --silent --show-error https://example.com --output /dev/null \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /workspace/campaign/research/showdown/docker/build-v42/target/release/ndabi_v42 /usr/local/bin/ndabi_v42

LABEL org.opencontainers.image.title="NDABI PostgreSQL repaired scale client v4.3"
LABEL org.whitetree.ndabi.campaign="v4.3"
LABEL org.whitetree.ndabi.rust="1.99"

USER 65532:65532
ENTRYPOINT ["/usr/local/bin/ndabi_v42"]
