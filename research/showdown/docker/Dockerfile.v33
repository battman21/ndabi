FROM rust:1.99-trixie AS builder

# Debian 13 trixie. Upgrade the image, then require the rustc and CA floors.
RUN apt-get update \
    && apt-get upgrade --yes \
    && apt-get install --yes --no-install-recommends ca-certificates \
    && dpkg --compare-versions "$(rustc --version | awk '{print $2}')" ge "1.96.1" \
    && dpkg --compare-versions "$(dpkg-query -W -f '$${Version}' ca-certificates)" ge "20250419+deb13u1" \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/campaign
COPY research/showdown/docker/build-v33/Cargo.toml research/showdown/docker/build-v33/Cargo.lock ./
COPY research/showdown/docker/lib-v33.rs ./src/lib.rs
COPY research/showdown/src/alloc.rs research/showdown/src/column_v03.rs research/showdown/src/replay_v01.rs ./src/
COPY research/showdown/src/bin/ndabi_v33.rs ./src/bin/
COPY research/showdown/src/v33/mod.rs ./src/v33/mod.rs

RUN RUSTFLAGS="-D warnings" cargo build --release --locked --bin ndabi_v33

FROM debian:trixie-slim AS runtime

RUN apt-get update \
    && apt-get upgrade --yes \
    && apt-get install --yes --no-install-recommends ca-certificates curl \
    && dpkg --compare-versions "$(dpkg-query -W -f '$${Version}' ca-certificates)" ge "20250419+deb13u1" \
    && curl --fail --silent --show-error https://example.com --output /dev/null \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /workspace/campaign/target/release/ndabi_v33 /usr/local/bin/ndabi_v33

LABEL org.opencontainers.image.title="NDABI PostgreSQL Linux client v3.3"
LABEL org.whitetree.ndabi.campaign="v3.3"
LABEL org.whitetree.ndabi.rust="1.99"

USER 65532:65532
ENTRYPOINT ["/usr/local/bin/ndabi_v33"]
