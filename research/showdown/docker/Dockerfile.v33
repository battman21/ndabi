FROM rust:1.92-bookworm@sha256:e90e846de4124376164ddfbaab4b0774c7bdeef5e738866295e5a90a34a307a2 AS builder

# CVE-2026-111943: install the current Debian trust store, then require the bookworm-security fix or newer.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates \
    && dpkg --compare-versions "$(dpkg-query -W -f '$${Version}' ca-certificates)" ge "20250419~deb12u2" \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/campaign
COPY research/showdown/docker/build-v33/Cargo.toml research/showdown/docker/build-v33/Cargo.lock ./
COPY research/showdown/docker/lib-v33.rs ./src/lib.rs
COPY research/showdown/src/alloc.rs research/showdown/src/column_v03.rs ./src/
COPY research/showdown/src/bin/ndabi_v33.rs ./src/bin/
COPY research/showdown/src/v33/mod.rs ./src/v33/mod.rs

RUN RUSTFLAGS="-D warnings" cargo build --release --locked --bin ndabi_v33

FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241 AS runtime

COPY --from=builder /workspace/campaign/target/release/ndabi_v33 /usr/local/bin/ndabi_v33

LABEL org.opencontainers.image.title="NDABI PostgreSQL Linux client v3.3"
LABEL org.whitetree.ndabi.campaign="v3.3"
LABEL org.whitetree.ndabi.rust="1.92"

USER 65532:65532
ENTRYPOINT ["/usr/local/bin/ndabi_v33"]
