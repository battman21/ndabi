FROM rust:1.92-bookworm@sha256:e90e846de4124376164ddfbaab4b0774c7bdeef5e738866295e5a90a34a307a2 AS builder

WORKDIR /workspace/campaign
COPY research/showdown/docker/build-v40/Cargo.toml research/showdown/docker/build-v40/Cargo.lock ./
COPY research/showdown/docker/lib-v34.rs ./src/lib.rs
COPY research/showdown/src/alloc.rs research/showdown/src/column_v03.rs ./src/
COPY research/showdown/src/replay_v01.rs research/showdown/src/session_v01.rs ./src/
COPY research/showdown/src/bin/ndabi_v40.rs ./src/bin/
COPY research/showdown/src/v40/mod.rs ./src/v40/mod.rs

RUN RUSTFLAGS="-D warnings" cargo build --release --locked --bin ndabi_v40

FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241 AS runtime

COPY --from=builder /workspace/campaign/target/release/ndabi_v40 /usr/local/bin/ndabi_v40

LABEL org.opencontainers.image.title="NDABI PostgreSQL gateway client v4.0"
LABEL org.whitetree.ndabi.campaign="v4.0"
LABEL org.whitetree.ndabi.rust="1.92"

USER 65532:65532
ENTRYPOINT ["/usr/local/bin/ndabi_v40"]
